APP_ENV=development
DATABASE_PATH=./data/kwork-assistant.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_KEEP_ALIVE=2m
AI_TIMEOUT_SECONDS=120
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3

KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_PHONE_LAST=
KWORK_POLL_LIMIT=50

EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_TLS=true
EMAIL_FOLDER=INBOX
EMAIL_POLL_INTERVAL=60s
EMAIL_LOOKBACK_HOURS=48
EMAIL_SENDER_FILTER=notify@kwork.ru
EMAIL_SUBJECT_FILTER=

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
